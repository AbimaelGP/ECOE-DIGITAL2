# Copia este contenido en Streamlit Cloud → App → Settings → Secrets
# (o en .streamlit/secrets.toml / .env para correrlo localmente). NUNCA lo subas a GitHub.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_KEY = "tu-clave-anon-de-supabase"
GEMINI_API_KEY = "tu-clave-de-gemini"

# OPCIONAL: permite que la app cree sola las tablas/columnas nuevas (migraciones que solo AGREGAN).
# Supabase → Connect → "Session pooler" → URI (cambia [YOUR-PASSWORD] por la contraseña de la base)
DATABASE_URL = "postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
